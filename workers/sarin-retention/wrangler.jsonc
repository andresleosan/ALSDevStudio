{
  "name": "als-sarin-retention-local",
  "main": "index.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "vars": {
    "SARIN_RETENTION_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "SARIN_DB",
      "database_name": "als-sarin-local",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "../../migrations/sarin"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "production": {
      "name": "als-sarin-retention",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "SARIN_RETENTION_ENABLED": "true"
      },
      "d1_databases": [
        {
          "binding": "SARIN_DB",
          "database_name": "alsdevstudio-sarin",
          "database_id": "ba6d723c-57fb-472d-b9c0-1308c24912e3",
          "migrations_dir": "../../migrations/sarin"
        }
      ],
      "triggers": {
        "crons": [
          "0 * * * *"
        ]
      }
    }
  }
}
