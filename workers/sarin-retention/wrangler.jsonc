{
  "name": "als-sarin-retention",
  "main": "index.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["0 * * * *"] },
  "vars": { "SARIN_RETENTION_ENABLED": "false" },
  "d1_databases": [
    {
      "binding": "SARIN_DB",
      "database_name": "sarin-local",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "../../migrations/sarin"
    }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
