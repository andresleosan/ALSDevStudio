{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "alsdevstudio-sarin-local",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-13",
  "vars": {
    "SARIN_ENABLED": "false",
    "SARIN_INPUT_PRICE_MICROS": "300000",
    "SARIN_OUTPUT_PRICE_MICROS": "1200000",
    "SARIN_DAILY_BUDGET_MICROS": "1000000",
    "SARIN_MONTHLY_BUDGET_MICROS": "10000000"
  },
  "d1_databases": [{
    "binding": "SARIN_DB",
    "database_name": "als-sarin-local",
    "database_id": "00000000-0000-0000-0000-000000000002",
    "migrations_dir": "migrations/sarin"
  }]
}
