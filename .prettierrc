{
  "printWidth": 120,
  "singleQuote": true,
  "htmlWhitespaceSensitivity": "css",
  "bracketSameLine": true,
  "overrides": [
    { "files": "*.html", "options": { "singleQuote": false } },
    { "files": "*.svg", "options": { "parser": "html", "singleQuote": false, "printWidth": 100000 } }
  ]
}
