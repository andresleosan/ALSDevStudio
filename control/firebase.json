{
  "functions": { "source": "functions", "runtime": "nodejs22", "ignore": ["node_modules", "test", ".env.*", "*.log"] },
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "hosting": {
    "public": "dist",
    "predeploy": ["node scripts/assert-production.mjs"],
    "ignore": ["**/.*"],
    "rewrites": [{ "source": "/api/**", "function": { "functionId": "controlApi", "region": "us-central1" } }],
    "headers": [{ "source": "**", "headers": [
      { "key": "Cache-Control", "value": "no-store" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://apis.google.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com; frame-src https://*.firebaseapp.com https://accounts.google.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" }
    ] }]
  },
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 9099 },
    "firestore": { "host": "127.0.0.1", "port": 8085 },
    "functions": { "host": "127.0.0.1", "port": 5001 },
    "ui": { "enabled": true, "host": "127.0.0.1", "port": 4001 },
    "hub": { "host": "127.0.0.1", "port": 4401 },
    "logging": { "host": "127.0.0.1", "port": 4501 },
    "singleProjectMode": true
  }
}
